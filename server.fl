;; 감성 지능 일기 (Emotional Intelligence Diary)
;; FreeLang v11 | 포트 40282 | MariaDB emotional_diary
;; Groq API (llama-3.3-70b) 감성 분석

(env_load ".env")

(define PORT 40282)
(define DB   "emotional_diary")
(define GROQ_URL "https://api.groq.com/openai/v1/chat/completions")
(define GROQ_KEY (or (env_get "GROQ_API_KEY") ""))

;; ── DB 초기화 ────────────────────────────────────────────────────────────────

(mariadb_exec DB "CREATE TABLE IF NOT EXISTS diaries (
  id            INT AUTO_INCREMENT PRIMARY KEY,
  date          DATE NOT NULL UNIQUE,
  text_content  TEXT NOT NULL,
  emotion_primary VARCHAR(50),
  emotion_scores  JSON,
  emotion_summary TEXT,
  recommendations JSON,
  ai_advice     TEXT,
  mood_score    INT DEFAULT 5,
  created_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_date (date)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4" [])

;; ── Groq 감성 분석 (curl 기반 — FreeLang http-post 헤더 미지원) ────────────

(defn analyze-emotion [$text]
  (if (= (length GROQ_KEY) 0)
    {"emotion_primary" "미설정" "mood_score" 5
     "emotion_scores" {"기쁨" 5 "슬픔" 5 "분노" 5 "불안" 5 "평온" 5 "희망" 5 "혼란" 5}
     "emotion_summary" "GROQ_API_KEY 미설정"
     "ai_advice" ".env에 GROQ_API_KEY를 설정하세요"
     "recommendations" ["산책하기" "음악 듣기" "차 한잔 마시기"]}
    (try
      (let [$prompt (str "감성 분석 전문가로서 일기를 분석하고 순수 JSON만 응답(코드블록 없이).\n일기: \"" $text "\"\n형식: {\"emotion_primary\":\"기쁨\",\"mood_score\":7,\"emotion_scores\":{\"기쁨\":7,\"슬픔\":2,\"분노\":1,\"불안\":3,\"평온\":6,\"희망\":8,\"혼란\":2},\"emotion_summary\":\"요약\",\"ai_advice\":\"조언\",\"recommendations\":[\"활동1\",\"활동2\",\"활동3\"]}")
            $payload (json-stringify
              {"model" "llama-3.3-70b-versatile"
               "max_tokens" 800
               "messages" [{"role" "user" "content" $prompt}]})
            $_  (file_write "/tmp/ed-groq.json" $payload)
            $r  (shell-exec-result (str "curl -s -X POST " GROQ_URL
                                        " -H 'Content-Type: application/json'"
                                        " -H 'Authorization: Bearer " GROQ_KEY "'"
                                        " -d @/tmp/ed-groq.json"))
            $body    (json-parse (get $r "stdout"))
            $choices (get $body "choices")
            $c0      (first $choices)
            $raw     (get (get $c0 "message") "content")
            $clean   (str-trim (replace (replace $raw "```json" "") "```" ""))]
        (json-parse $clean))
      (catch $e
        {"emotion_primary" "분석 오류"
         "mood_score" 5
         "emotion_scores" {"기쁨" 0 "슬픔" 0 "분노" 0 "불안" 0 "평온" 5 "희망" 0 "혼란" 0}
         "emotion_summary" (str "오류: " (str-slice (str $e) 0 80))
         "ai_advice" "잠시 후 다시 시도해주세요"
         "recommendations" ["깊게 숨쉬기" "잠깐 휴식" "물 한 잔 마시기"]}))))

;; ── API ──────────────────────────────────────────────────────────────────────

;; 감성 분석 (일기 저장 전 미리 분석)
(server-post "/api/analyze" (fn [$req]
  (let [$body (get $req "body")
        $text (get $body "text" "")]
    (if (= (length $text) 0)
      (server-json {"success" false "message" "텍스트가 없습니다"} 400)
      (let [$result (analyze-emotion $text)]
        (server-json {"success" true "data" $result}))))))

;; 일기 저장/수정
(server-post "/api/diary" (fn [$req]
  (let [$body        (get $req "body")
        $date        (get $body "date")
        $text        (get $body "text_content")
        $analysis    (get $body "analysis_result" {})
        $emotion     (get $analysis "emotion_primary" nil)
        $scores      (json-stringify (get $analysis "emotion_scores" {}))
        $summary     (get $analysis "emotion_summary" nil)
        $recs        (json-stringify (get $analysis "recommendations" []))
        $advice      (get $analysis "ai_advice" nil)
        $mood        (get $analysis "mood_score" 5)]
    (if (or (= $date nil) (= $text nil))
      (server-json {"success" false "message" "date와 text_content 필수"} 400)
      (let [$existing (mariadb_one DB "SELECT id FROM diaries WHERE date = ?" [$date])]
        (if $existing
          (do
            (mariadb_exec DB
              "UPDATE diaries SET text_content=?, emotion_primary=?, emotion_scores=?, emotion_summary=?, recommendations=?, ai_advice=?, mood_score=? WHERE date=?"
              [$text $emotion $scores $summary $recs $advice $mood $date])
            (server-json {"success" true "message" "일기 수정 완료" "date" $date}))
          (do
            (mariadb_exec DB
              "INSERT INTO diaries (date, text_content, emotion_primary, emotion_scores, emotion_summary, recommendations, ai_advice, mood_score) VALUES (?,?,?,?,?,?,?,?)"
              [$date $text $emotion $scores $summary $recs $advice $mood])
            (server-json {"success" true "message" "일기 저장 완료" "date" $date}))))))))

;; 일기 목록 (최근 30일)
(server-get "/api/diary" (fn [$req]
  (let [$rows (mariadb_query DB
                "SELECT id, date, LEFT(text_content,100) AS preview, emotion_primary, mood_score, created_at FROM diaries ORDER BY date DESC LIMIT 30"
                [])]
    (server-json {"success" true "data" $rows "count" (length $rows)}))))

;; 특정 날짜 일기
(server-get "/api/diary/:date" (fn [$req]
  (let [$date (get (get $req "params") "date")
        $row  (mariadb_one DB "SELECT * FROM diaries WHERE date = ?" [$date])]
    (if $row
      (server-json {"success" true "data" $row})
      (server-json {"success" false "message" "일기 없음"} 404)))))

;; 감정 통계
(server-get "/api/diary/stats/emotions" (fn [$req]
  (let [$rows (mariadb_query DB
                "SELECT emotion_primary, COUNT(*) AS count FROM diaries WHERE emotion_primary IS NOT NULL GROUP BY emotion_primary ORDER BY count DESC"
                [])]
    (server-json {"success" true "data" $rows}))))

;; 기분 통계 (최근 30일)
(server-get "/api/diary/stats/mood" (fn [$req]
  (let [$rows (mariadb_query DB
                "SELECT date, mood_score FROM diaries WHERE mood_score IS NOT NULL ORDER BY date DESC LIMIT 30"
                [])]
    (server-json {"success" true "data" $rows}))))

;; 일기 삭제
(server-delete "/api/diary/:date" (fn [$req]
  (let [$date (get (get $req "params") "date")]
    (mariadb_exec DB "DELETE FROM diaries WHERE date = ?" [$date])
    (server-json {"success" true "message" "삭제 완료" "date" $date}))))

;; ── 헬스체크 ─────────────────────────────────────────────────────────────────

(server-get "/health" (fn [$req]
  (server-json {"status" "healthy" "app" "emotional-diary" "port" PORT "db" DB
                "groq" (if (> (length GROQ_KEY) 0) "configured" "missing")})))

;; ── 메인 UI ──────────────────────────────────────────────────────────────────

(server-get "/" (fn [$req]
  (server-html (str "<!DOCTYPE html><html lang=\"ko\"><head><meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">
<title>감성 일기</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f0f4f8;color:#2d3748;min-height:100vh}
.header{background:linear-gradient(135deg,#667eea,#764ba2);color:white;padding:1.5rem 2rem}
.header h1{font-size:1.5rem;font-weight:700}
.header p{opacity:.85;font-size:.9rem;margin-top:.3rem}
.container{max-width:900px;margin:2rem auto;padding:0 1rem;display:grid;gap:1.5rem}
.card{background:white;border-radius:12px;padding:1.5rem;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.card h2{font-size:1.1rem;color:#4a5568;margin-bottom:1rem;border-bottom:2px solid #e2e8f0;padding-bottom:.5rem}
textarea{width:100%;min-height:150px;border:2px solid #e2e8f0;border-radius:8px;padding:.8rem;font-size:.95rem;resize:vertical;outline:none;transition:.2s}
textarea:focus{border-color:#667eea}
.date-input{width:100%;border:2px solid #e2e8f0;border-radius:8px;padding:.7rem;font-size:.95rem;outline:none}
.date-input:focus{border-color:#667eea}
.btn{padding:.7rem 1.5rem;border:none;border-radius:8px;cursor:pointer;font-size:.9rem;font-weight:600;transition:.2s}
.btn-primary{background:#667eea;color:white}.btn-primary:hover{background:#5a6fd6}
.btn-analyze{background:#38b2ac;color:white}.btn-analyze:hover{background:#319795}
.btn-danger{background:#fc8181;color:white;font-size:.8rem;padding:.4rem .8rem}
.btn-row{display:flex;gap:.8rem;margin-top:1rem;flex-wrap:wrap}
.result-card{background:#f7fafc;border-left:4px solid #667eea;border-radius:0 8px 8px 0;padding:1rem;margin-top:1rem;display:none}
.emotion-badge{display:inline-block;background:#667eea;color:white;border-radius:20px;padding:.3rem .8rem;font-size:.85rem;font-weight:600}
.mood-bar{height:8px;border-radius:4px;background:#e2e8f0;margin:.5rem 0}
.mood-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,#fc8181,#f6ad55,#68d391);transition:.5s}
.rec-list{list-style:none;margin-top:.5rem}
.rec-list li{padding:.3rem 0;padding-left:1.2rem;position:relative;font-size:.9rem}
.rec-list li::before{content:'→';position:absolute;left:0;color:#667eea}
.history-item{border:1px solid #e2e8f0;border-radius:8px;padding:1rem;margin-bottom:.8rem;display:flex;justify-content:space-between;align-items:center;cursor:pointer}
.history-item:hover{border-color:#667eea;background:#f7fafc}
.history-meta{font-size:.8rem;color:#718096;margin-top:.3rem}
.spinner{display:none;margin:1rem auto;text-align:center;color:#667eea}
.score-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:.5rem;margin-top:.8rem}
.score-item{text-align:center;padding:.5rem;background:#f7fafc;border-radius:8px;font-size:.85rem}
.score-num{font-size:1.3rem;font-weight:700;color:#667eea}
</style>
</head>
<body>
<div class=\"header\"><h1>📔 감성 지능 일기</h1><p>AI가 당신의 감정을 분석하고 맞춤 조언을 제공합니다</p></div>
<div class=\"container\">
  <div class=\"card\">
    <h2>✍️ 오늘의 일기</h2>
    <input type=\"date\" class=\"date-input\" id=\"diaryDate\">
    <br><br>
    <textarea id=\"diaryText\" placeholder=\"오늘 어떤 하루였나요? 자유롭게 써보세요...\"></textarea>
    <div class=\"btn-row\">
      <button class=\"btn btn-analyze\" onclick=\"analyzeEmotion()\">🔍 감성 분석</button>
      <button class=\"btn btn-primary\" onclick=\"saveDiary()\">💾 저장</button>
    </div>
    <div class=\"spinner\" id=\"spinner\">⏳ AI 분석 중...</div>
    <div class=\"result-card\" id=\"resultCard\">
      <div style=\"margin-bottom:.8rem\">
        <span class=\"emotion-badge\" id=\"emotionBadge\">-</span>
        <span style=\"margin-left:.8rem;font-size:.9rem;color:#718096\">기분 점수: <strong id=\"moodScore\">-</strong>/10</span>
      </div>
      <div class=\"mood-bar\"><div class=\"mood-fill\" id=\"moodFill\"></div></div>
      <p id=\"emotionSummary\" style=\"font-size:.9rem;color:#4a5568;margin:.8rem 0\"></p>
      <p style=\"font-size:.85rem;color:#718096\"><strong>💡 조언:</strong> <span id=\"aiAdvice\"></span></p>
      <div class=\"score-grid\" id=\"scoreGrid\"></div>
      <p style=\"font-size:.85rem;color:#718096;margin-top:.8rem\"><strong>🎯 추천 활동:</strong></p>
      <ul class=\"rec-list\" id=\"recList\"></ul>
    </div>
  </div>
  <div class=\"card\">
    <h2>📅 일기 기록</h2>
    <div id=\"historyList\"><p style=\"color:#a0aec0\">일기를 불러오는 중...</p></div>
  </div>
</div>
<script>
let lastAnalysis = null;
// 오늘 날짜 설정
document.getElementById('diaryDate').value = new Date().toISOString().split('T')[0];

async function analyzeEmotion() {
  const text = document.getElementById('diaryText').value.trim();
  if (!text) { alert('일기 내용을 입력하세요'); return; }
  document.getElementById('spinner').style.display = 'block';
  document.getElementById('resultCard').style.display = 'none';
  try {
    const r = await fetch('/api/analyze', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text})});
    const d = await r.json();
    if (d.success) { showResult(d.data); lastAnalysis = d.data; }
    else alert('분석 실패: ' + d.message);
  } catch(e) { alert('오류: ' + e.message); }
  document.getElementById('spinner').style.display = 'none';
}

function showResult(data) {
  document.getElementById('emotionBadge').textContent = data.emotion_primary || '-';
  const mood = data.mood_score || 5;
  document.getElementById('moodScore').textContent = mood;
  document.getElementById('moodFill').style.width = (mood*10) + '%';
  document.getElementById('emotionSummary').textContent = data.emotion_summary || '';
  document.getElementById('aiAdvice').textContent = data.ai_advice || '';
  const scores = data.emotion_scores || {};
  document.getElementById('scoreGrid').innerHTML = Object.entries(scores).map(([k,v]) =>
    '<div class=\"score-item\"><div class=\"score-num\">' + v + '</div><div>' + k + '</div></div>'
  ).join('');
  const recs = data.recommendations || [];
  document.getElementById('recList').innerHTML = recs.map(r => '<li>' + r + '</li>').join('');
  document.getElementById('resultCard').style.display = 'block';
}

async function saveDiary() {
  const date = document.getElementById('diaryDate').value;
  const text = document.getElementById('diaryText').value.trim();
  if (!date || !text) { alert('날짜와 내용을 입력하세요'); return; }
  const body = {date, text_content: text, analysis_result: lastAnalysis};
  const r = await fetch('/api/diary', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  const d = await r.json();
  if (d.success) { alert('저장 완료!'); loadHistory(); }
  else alert('저장 실패: ' + d.message);
}

async function loadHistory() {
  const r = await fetch('/api/diary');
  const d = await r.json();
  const el = document.getElementById('historyList');
  if (!d.data || !d.data.length) { el.innerHTML = '<p style=\"color:#a0aec0\">아직 일기가 없습니다</p>'; return; }
  el.innerHTML = d.data.map(item =>
    '<div class=\"history-item\" onclick=\"loadDiary(\\'' + item.date + '\\')\">' +
    '<div><strong>' + item.date + '</strong>' +
    (item.emotion_primary ? ' <span class=\"emotion-badge\" style=\"font-size:.75rem;padding:.2rem .6rem\">' + item.emotion_primary + '</span>' : '') +
    '<div class=\"history-meta\">' + (item.preview||'').substring(0,60) + '...</div></div>' +
    '<div style=\"text-align:right\">' + (item.mood_score ? '😊 ' + item.mood_score + '/10' : '') + '</div>' +
    '</div>'
  ).join('');
}

async function loadDiary(date) {
  const r = await fetch('/api/diary/' + date);
  const d = await r.json();
  if (d.success) {
    document.getElementById('diaryDate').value = d.data.date;
    document.getElementById('diaryText').value = d.data.text_content;
    if (d.data.emotion_primary) {
      try {
        const scores = typeof d.data.emotion_scores === 'string' ? JSON.parse(d.data.emotion_scores) : d.data.emotion_scores;
        const recs = typeof d.data.recommendations === 'string' ? JSON.parse(d.data.recommendations) : d.data.recommendations;
        lastAnalysis = {emotion_primary:d.data.emotion_primary,mood_score:d.data.mood_score,emotion_scores:scores,emotion_summary:d.data.emotion_summary,ai_advice:d.data.ai_advice,recommendations:recs};
        showResult(lastAnalysis);
      } catch(e) {}
    }
  }
}

loadHistory();
</script>
</body></html>"))))

(println (str "📔 감성 지능 일기 on :" PORT " | Groq AI 감성 분석"))
(server-start PORT)
